            <component
              refId="Package\ETL PROCES\ucitavanje podataka iz tabele orders"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="ucitavanje podataka iz tabele orders"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[sales]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    CAST(CONVERT(CHAR(8), s.SalesDate, 112) AS INT)                   AS DatumSID,     -- YYYYMMDD
    CAST(s.SalesDate AS DATE)                                          AS [Date],
    CAST(DATEPART(DAY,     s.SalesDate) AS TINYINT)                    AS DayNumberOfMonth,
    -- Pon=1..Ned=7, nezavisno od DATEFIRST:
    CAST( ((DATEPART(WEEKDAY, s.SalesDate) + @@DATEFIRST + 5) % 7) + 1 AS TINYINT) AS DayNumberOfWeek,
    CAST(DATEPART(MONTH,   s.SalesDate) AS TINYINT)                    AS MonthNumberOfYear,
    DATENAME(MONTH,        s.SalesDate)                                AS MonthNameOfYear,
    CAST(DATEPART(QUARTER, s.SalesDate) AS TINYINT)                    AS CalendarQuarter,
    CAST(DATEPART(YEAR,    s.SalesDate) AS SMALLINT)                   AS CalendarYear,
    CAST(CASE 
           WHEN (((DATEPART(WEEKDAY, s.SalesDate) + @@DATEFIRST + 5) % 7) + 1) IN (6,7) 
             THEN 1 ELSE 0 
         END AS BIT)                                                   AS IsWeekend
FROM GrocerySales.dbo.sales AS s
WHERE s.SalesDate IS NOT NULL;</property>
                <property
