    <DTS:Executable
      DTS:refId="Package\Kreiraj tabelu DimVreme"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{08BAEBAA-CA4E-4AFA-B307-DBD6DBFD1332}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Kreiraj tabelu DimVreme"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{053871B9-2090-4933-9DC9-7700EA52BCD7}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF DB_ID(N'DW_GrocerySales') IS NULL&#xA;    THROW 50001, 'Baza DW_GrocerySales ne postoji.', 1;&#xA;&#xA;-- 1) Skini sve FK koji referenciraju DimVreme&#xA;DECLARE @drop NVARCHAR(MAX) = N'';&#xA;SELECT @drop = @drop +&#xA;    N'ALTER TABLE ' + QUOTENAME(SCHEMA_NAME(pt.schema_id)) + N'.' + QUOTENAME(pt.name) +&#xA;    N' DROP CONSTRAINT ' + QUOTENAME(fk.name) + N';' + CHAR(10)&#xA;FROM DW_GrocerySales.sys.foreign_keys fk&#xA;JOIN DW_GrocerySales.sys.tables pt ON pt.object_id = fk.parent_object_id&#xA;WHERE fk.referenced_object_id = OBJECT_ID(N'DW_GrocerySales.dbo.DimVreme','U');&#xA;IF (@drop &lt;&gt; N'') EXEC DW_GrocerySales.sys.sp_executesql @drop;&#xA;&#xA;-- 2) Drop/Create DimVreme (DatumSID bez IDENTITY)&#xA;IF OBJECT_ID(N'DW_GrocerySales.dbo.DimVreme','U') IS NOT NULL&#xA;    DROP TABLE DW_GrocerySales.dbo.DimVreme;&#xA;&#xA;CREATE TABLE DW_GrocerySales.dbo.DimVreme&#xA;(&#xA;    DatumSID          INT           NOT NULL CONSTRAINT PK_DimVreme PRIMARY KEY, -- bez IDENTITY&#xA;    [Date]            DATE          NOT NULL,&#xA;    DayNumberOfMonth  TINYINT       NOT NULL,&#xA;    DayNumberOfWeek   TINYINT       NOT NULL,  -- 1=Pon ... 7=Ned&#xA;    MonthNumberOfYear TINYINT       NOT NULL,&#xA;    MonthNameOfYear   NVARCHAR(20)  NOT NULL,&#xA;    CalendarQuarter   TINYINT       NOT NULL,&#xA;    CalendarYear      SMALLINT      NOT NULL,&#xA;    IsWeekend         BIT           NOT NULL&#xA;);&#xA;&#xA;-- jedinstvenost datuma&#xA;CREATE UNIQUE NONCLUSTERED INDEX UX_DimVreme_Date&#xA;  ON DW_GrocerySales.dbo.DimVreme([Date]);&#xA;&#xA;-- 3) Seed: -1 / Unknown (IDENTITY_INSERT nije potreban jer nema IDENTITY)&#xA;INSERT INTO DW_GrocerySales.dbo.DimVreme&#xA;    (DatumSID,[Date],DayNumberOfMonth,DayNumberOfWeek,MonthNumberOfYear,MonthNameOfYear,CalendarQuarter,CalendarYear,IsWeekend)&#xA;VALUES&#xA;    (-1,'1900-01-01', 1, 1, 1, N'Unknown', 1, 1900, 0);&#xA;&#xA;-- 4) Vrati FK-ove za sve tabele koje imaju DatumSID (osim DimVreme)&#xA;DECLARE @add NVARCHAR(MAX) = N'';&#xA;SELECT @add = @add + N'&#xA;IF NOT EXISTS (SELECT 1 FROM DW_GrocerySales.sys.foreign_keys &#xA;               WHERE name = N''FK_' + t.name + '_DimVreme_DatumSID'')&#xA;BEGIN&#xA;  ALTER TABLE ' + QUOTENAME(s.name) + N'.' + QUOTENAME(t.name) + N'&#xA;    WITH NOCHECK ADD CONSTRAINT [FK_' + t.name + '_DimVreme_DatumSID]&#xA;    FOREIGN KEY ([DatumSID]) REFERENCES [DW_GrocerySales].[dbo].[DimVreme]([DatumSID]);&#xA;END&#xA;'&#xA;FROM DW_GrocerySales.sys.tables  t&#xA;JOIN DW_GrocerySales.sys.schemas s ON s.schema_id = t.schema_id&#xA;JOIN DW_GrocerySales.sys.columns c ON c.object_id = t.object_id&#xA;WHERE c.name = N'DatumSID'&#xA;  AND t.object_id &lt;&gt; OBJECT_ID(N'DW_GrocerySales.dbo.DimVreme','U');&#xA;IF (@add &lt;&gt; N'') EXEC DW_GrocerySales.sys.sp_executesql @add;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
