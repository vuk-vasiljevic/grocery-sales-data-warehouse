        <SQLTask:SqlTaskData
          SQLTask:Connection="{053871B9-2090-4933-9DC9-7700EA52BCD7}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF DB_ID(N'DW_GrocerySales') IS NULL&#xA;    THROW 50001, 'Baza DW_GrocerySales ne postoji na ovom serveru.', 1;&#xA;&#xA;-- 1) Skini sve FK koji referenciraju DimProizvod&#xA;DECLARE @drop NVARCHAR(MAX) = N'';&#xA;SELECT @drop = @drop +&#xA;    N'ALTER TABLE ' + QUOTENAME(SCHEMA_NAME(pt.schema_id)) + N'.' + QUOTENAME(pt.name) +&#xA;    N' DROP CONSTRAINT ' + QUOTENAME(fk.name) + N';' + CHAR(10)&#xA;FROM DW_GrocerySales.sys.foreign_keys fk&#xA;JOIN DW_GrocerySales.sys.tables pt ON pt.object_id = fk.parent_object_id&#xA;WHERE fk.referenced_object_id = OBJECT_ID(N'DW_GrocerySales.dbo.DimProizvod','U');&#xA;IF (@drop &lt;&gt; N'') EXEC DW_GrocerySales.sys.sp_executesql @drop;&#xA;&#xA;-- 2) DROP / CREATE DimProizvod (SMALLINT ključ!)&#xA;IF OBJECT_ID(N'DW_GrocerySales.dbo.DimProizvod','U') IS NOT NULL&#xA;    DROP TABLE DW_GrocerySales.dbo.DimProizvod;&#xA;&#xA;CREATE TABLE DW_GrocerySales.dbo.DimProizvod&#xA;(&#xA;    ProizvodSID   SMALLINT IDENTITY(1,1) NOT NULL&#xA;        CONSTRAINT PK_DimProizvod PRIMARY KEY,&#xA;&#xA;    -- prirodni ključ iz OLTP (po želji ga možeš ostaviti kao SMALLINT; nije u FK-u)&#xA;    ProductID     SMALLINT       NOT NULL,&#xA;    ProductName   NVARCHAR(100)  NOT NULL,&#xA;    CategoryName  NVARCHAR(100)  NOT NULL, &#xA;    Class         NVARCHAR(50)   NULL,&#xA;    Resistant     BIT            NULL,&#xA;    VitalityDays  SMALLINT       NULL&#xA;);&#xA;&#xA;-- 3) Seed -1 (Unknown)&#xA;SET IDENTITY_INSERT DW_GrocerySales.dbo.DimProizvod ON;&#xA;INSERT INTO DW_GrocerySales.dbo.DimProizvod&#xA;        (ProizvodSID, ProductID, ProductName, CategoryName,Class, Resistant, VitalityDays)&#xA;VALUES  (-1,          0,         N'Unknown',  N'Unknown', N'Unknown', NULL, NULL);&#xA;SET IDENTITY_INSERT DW_GrocerySales.dbo.DimProizvod OFF;&#xA;&#xA;-- 4) Indeksi&#xA;IF NOT EXISTS (SELECT 1 FROM DW_GrocerySales.sys.indexes &#xA;               WHERE name = N'UX_DimProizvod_ProductID'&#xA;                 AND object_id = OBJECT_ID(N'DW_GrocerySales.dbo.DimProizvod'))&#xA;    CREATE UNIQUE NONCLUSTERED INDEX UX_DimProizvod_ProductID&#xA;      ON DW_GrocerySales.dbo.DimProizvod (ProductID);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM DW_GrocerySales.sys.indexes &#xA;               WHERE name = N'IX_DimProizvod_CategoryName'&#xA;                 AND object_id = OBJECT_ID(N'DW_GrocerySales.dbo.DimProizvod'))&#xA;    CREATE NONCLUSTERED INDEX IX_DimProizvod_CategoryName&#xA;      ON DW_GrocerySales.dbo.DimProizvod (CategoryName);&#xA;&#xA;-- 5) Vrati FK-ove na sve tabele koje imaju kolonu ProizvodSID (osim same dimenzije)&#xA;DECLARE @add NVARCHAR(MAX) = N'';&#xA;SELECT @add = @add + N'&#xA;IF NOT EXISTS (SELECT 1 FROM DW_GrocerySales.sys.foreign_keys &#xA;               WHERE name = N''FK_' + t.name + '_DimProizvod_ProizvodSID'')&#xA;BEGIN&#xA;  ALTER TABLE ' + QUOTENAME(s.name) + N'.' + QUOTENAME(t.name) + N'&#xA;    WITH NOCHECK ADD CONSTRAINT [FK_' + t.name + '_DimProizvod_ProizvodSID]&#xA;    FOREIGN KEY ([ProizvodSID]) &#xA;    REFERENCES [DW_GrocerySales].[dbo].[DimProizvod]([ProizvodSID]);&#xA;END&#xA;'&#xA;FROM DW_GrocerySales.sys.tables  t&#xA;JOIN DW_GrocerySales.sys.schemas s ON s.schema_id = t.schema_id&#xA;JOIN DW_GrocerySales.sys.columns c ON c.object_id = t.object_id&#xA;WHERE c.name = N'ProizvodSID'&#xA;  AND t.object_id &lt;&gt; OBJECT_ID(N'DW_GrocerySales.dbo.DimProizvod','U');&#xA;&#xA;IF (@add &lt;&gt; N'') EXEC DW_GrocerySales.sys.sp_executesql @add;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
