      <DTS:ObjectData>
        <pipeline
          version="1">
          <components>
            <component
              refId="Package\ETL proces\ucitavanje podataka iz tabela products i categories"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="ucitavanje podataka iz tabela products i categories"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST(p.ProductID AS INT)                                        AS ProductID,
    CAST(LEFT(LTRIM(RTRIM(p.ProductName)), 100) AS NVARCHAR(100))   AS ProductName,
    CAST(LEFT(LTRIM(RTRIM(c.CategoryName)),100) AS NVARCHAR(100))   AS CategoryName,
    CAST(TRY_CONVERT(DECIMAL(10,2), p.Price) AS DECIMAL(10,2))      AS Price,
    CAST(LEFT(LTRIM(RTRIM(p.Class)),50) AS NVARCHAR(50))            AS Class,
    CAST(CASE WHEN TRY_CONVERT(INT, p.Resistant) IN (1,0)
              THEN TRY_CONVERT(BIT, p.Resistant)
              WHEN UPPER(LTRIM(RTRIM(p.Resistant))) IN (N'Y',N'YES',N'T',N'TRUE') THEN 1
              WHEN UPPER(LTRIM(RTRIM(p.Resistant))) IN (N'N',N'NO',N'F',N'FALSE')  THEN 0
              ELSE NULL END AS BIT)                                 AS Resistant,
    CAST(TRY_CONVERT(SMALLINT, p.VitalityDays) AS SMALLINT)         AS VitalityDays
FROM dbo.products   AS p
JOIN dbo.categories AS c
  ON c.CategoryID = p.CategoryID
WHERE p.ProductID IS NOT NULL
  AND LEN(LTRIM(RTRIM(ISNULL(p.ProductName,N'')))) &gt; 0
  AND LEN(LTRIM(RTRIM(ISNULL(c.CategoryName,N'')))) &gt; 0;</property>
                <property
