                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    s.SalesID                                   AS SourceSalesID,
    s.TransactionNumber,
    CAST(s.ProductID   AS INT)                  AS ProductID,
    CAST(s.CustomerID  AS INT)                  AS CustomerID,
    s.SalesDate,
    CAST(CONVERT(CHAR(8), s.SalesDate,112) AS INT) AS DatumSID,  -- YYYYMMDD
    CAST(s.Quantity    AS INT)                  AS Quantity,
    CAST(s.Discount    AS DECIMAL(9,4))         AS Discount,
    CAST(s.TotalPrice  AS DECIMAL(12,2))        AS TotalPrice,
    CAST(p.Price       AS DECIMAL(10,2))        AS UnitPrice
FROM GrocerySales.dbo.sales s
JOIN GrocerySales.dbo.products p
  ON p.ProductID = s.ProductID
WHERE s.SalesDate IS NOT NULL;</property>
