      DTS:Description="Execute SQL Task"
      DTS:DTSID="{25EE03BE-DADF-49D9-B036-5F6BD1EE2BD0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Kreiraj tabelu cinjenica u skladistu podataka"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{053871B9-2090-4933-9DC9-7700EA52BCD7}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF DB_ID(N'DW_GrocerySales') IS NULL&#xA;    THROW 50001, 'Baza DW_GrocerySales ne postoji na ovom serveru.', 1;&#xA;&#xA;-- 1) Skini FK-ove koji referenciraju fact&#xA;DECLARE @drop NVARCHAR(MAX) = N'';&#xA;SELECT @drop = @drop +&#xA;    N'ALTER TABLE ' + QUOTENAME(SCHEMA_NAME(pt.schema_id)) + N'.' + QUOTENAME(pt.name) +&#xA;    N' DROP CONSTRAINT ' + QUOTENAME(fk.name) + N';' + CHAR(10)&#xA;FROM DW_GrocerySales.sys.foreign_keys fk&#xA;JOIN DW_GrocerySales.sys.tables pt ON pt.object_id = fk.parent_object_id&#xA;WHERE fk.referenced_object_id = OBJECT_ID(N'DW_GrocerySales.dbo.FactProdaja','U');&#xA;IF (@drop &lt;&gt; N'') EXEC DW_GrocerySales.sys.sp_executesql @drop;&#xA;&#xA;-- 2) DROP/CREATE&#xA;IF OBJECT_ID(N'DW_GrocerySales.dbo.FactProdaja','U') IS NOT NULL&#xA;    DROP TABLE DW_GrocerySales.dbo.FactProdaja;&#xA;&#xA;CREATE TABLE DW_GrocerySales.dbo.FactProdaja&#xA;(&#xA;    -- Primarni ključ sa IDENTITY&#xA;    FactProdajaID BIGINT IDENTITY(1,1) NOT NULL&#xA;        CONSTRAINT PK_FactProdaja PRIMARY KEY,&#xA;&#xA;    -- Veze na dimenzije&#xA;    ProizvodSID SMALLINT       NULL,&#xA;    KupacSID INT               NULL,&#xA;    DatumSID INT               NULL,  -- YYYYMMDD&#xA;&#xA;    -- Degenerisani ključ&#xA;    TransactionNumber NVARCHAR(50) NULL,&#xA;&#xA;    -- Trag iz izvora&#xA;    SourceSalesID INT NULL,&#xA;&#xA;    -- MERE (isti tipovi kao u OLTP)&#xA;    Quantity TINYINT NULL,&#xA;    Discount FLOAT NULL,&#xA;    TotalPrice FLOAT NULL,&#xA;    UnitPrice FLOAT NULL,   -- dodata po analogiji iz izvora (možeš je računati u ETL-u)&#xA;&#xA;    -- Izvedene kolone (opciono)&#xA;    GrossSales FLOAT NULL,&#xA;    EffectiveDiscountAmount FLOAT NULL,&#xA;    EffectiveDiscountPct FLOAT NULL,&#xA;    UnitNetPrice FLOAT NULL,&#xA;    HasDiscount BIT NULL&#xA;);&#xA;&#xA;-- 3) Nema CHECK ni FOREIGN KEY ograničenja — sve može da se upiše&#xA;&#xA;-- 4) Indeksi&#xA;CREATE NONCLUSTERED INDEX IX_FactProdaja_Date   ON DW_GrocerySales.dbo.FactProdaja (DatumSID);&#xA;CREATE NONCLUSTERED INDEX IX_FactProdaja_Prod   ON DW_GrocerySales.dbo.FactProdaja (ProizvodSID);&#xA;CREATE NONCLUSTERED INDEX IX_FactProdaja_Cust   ON DW_GrocerySales.dbo.FactProdaja (KupacSID);&#xA;CREATE NONCLUSTERED INDEX IX_FactProdaja_Trans  ON DW_GrocerySales.dbo.FactProdaja (TransactionNumber);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
