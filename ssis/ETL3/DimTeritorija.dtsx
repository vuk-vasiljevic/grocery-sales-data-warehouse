    <DTS:Executable
      DTS:refId="Package\Kreiraj tabelu DimTeritorija"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2BFC2D5D-2E86-4FB1-8B4B-27F491B3E631}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Kreiraj tabelu DimTeritorija"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{053871B9-2090-4933-9DC9-7700EA52BCD7}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF DB_ID(N'DW_GrocerySales') IS NULL&#xA;    THROW 50001, 'Baza DW_GrocerySales ne postoji na ovom serveru.', 1;&#xA;&#xA;-- 1) Drop svih FK koji referenciraju DW_GrocerySales.dbo.DimTeritorija&#xA;DECLARE @drop NVARCHAR(MAX) = N'';&#xA;SELECT @drop = @drop +&#xA;    N'ALTER TABLE ' + QUOTENAME(SCHEMA_NAME(pt.schema_id)) + N'.' + QUOTENAME(pt.name) +&#xA;    N' DROP CONSTRAINT ' + QUOTENAME(fk.name) + N';' + CHAR(10)&#xA;FROM DW_GrocerySales.sys.foreign_keys fk&#xA;JOIN DW_GrocerySales.sys.tables pt ON pt.object_id = fk.parent_object_id&#xA;WHERE fk.referenced_object_id = OBJECT_ID(N'DW_GrocerySales.dbo.DimTeritorija','U');&#xA;IF (@drop &lt;&gt; N'') EXEC DW_GrocerySales.sys.sp_executesql @drop;&#xA;&#xA;-- 2) Drop/Create DimTeritorija&#xA;IF OBJECT_ID(N'DW_GrocerySales.dbo.DimTeritorija','U') IS NOT NULL&#xA;    DROP TABLE DW_GrocerySales.dbo.DimTeritorija;&#xA;&#xA;CREATE TABLE DW_GrocerySales.dbo.DimTeritorija&#xA;(&#xA;    TeritorijaSID INT IDENTITY(1,1) NOT NULL CONSTRAINT PK_DimTeritorija PRIMARY KEY,&#xA;    CityID        TINYINT        NOT NULL,&#xA;    CityName      NVARCHAR(100)  NOT NULL,&#xA;    CountryName   NVARCHAR(100)  NOT NULL,&#xA;    CountryCode   NCHAR(2)       NOT NULL&#xA;);&#xA;&#xA;-- -1 / Unknown seed&#xA;SET IDENTITY_INSERT DW_GrocerySales.dbo.DimTeritorija ON;&#xA;INSERT INTO DW_GrocerySales.dbo.DimTeritorija (TeritorijaSID, CityID, CityName, CountryName, CountryCode)&#xA;VALUES (-1, 0, N'Unknown', N'Unknown', N'UN');&#xA;SET IDENTITY_INSERT DW_GrocerySales.dbo.DimTeritorija OFF;&#xA;&#xA;-- 3) Indeksi&#xA;IF NOT EXISTS (SELECT 1 FROM DW_GrocerySales.sys.indexes &#xA;               WHERE name = N'UX_DimTeritorija_CityID' &#xA;                 AND object_id = OBJECT_ID(N'DW_GrocerySales.dbo.DimTeritorija'))&#xA;    CREATE UNIQUE NONCLUSTERED INDEX UX_DimTeritorija_CityID&#xA;      ON DW_GrocerySales.dbo.DimTeritorija (CityID);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM DW_GrocerySales.sys.indexes &#xA;               WHERE name = N'IX_DimTeritorija_CountryCode_CityName' &#xA;                 AND object_id = OBJECT_ID(N'DW_GrocerySales.dbo.DimTeritorija'))&#xA;    CREATE NONCLUSTERED INDEX IX_DimTeritorija_CountryCode_CityName&#xA;      ON DW_GrocerySales.dbo.DimTeritorija (CountryCode, CityName);&#xA;&#xA;-- 4) Vrati FK-ove na sve tabele koje imaju kolonu TeritorijaSID (osim same dimenzije)&#xA;DECLARE @add NVARCHAR(MAX) = N'';&#xA;SELECT @add = @add + N'&#xA;IF NOT EXISTS (SELECT 1 FROM DW_GrocerySales.sys.foreign_keys &#xA;               WHERE name = N''FK_' + t.name + '_DimTeritorija_TeritorijaSID'')&#xA;BEGIN&#xA;  ALTER TABLE ' + QUOTENAME(s.name) + N'.' + QUOTENAME(t.name) + N'&#xA;    WITH NOCHECK ADD CONSTRAINT [FK_' + t.name + '_DimTeritorija_TeritorijaSID]&#xA;    FOREIGN KEY ([TeritorijaSID]) REFERENCES [DW_GrocerySales].[dbo].[DimTeritorija]([TeritorijaSID]);&#xA;END&#xA;'&#xA;FROM DW_GrocerySales.sys.tables  t&#xA;JOIN DW_GrocerySales.sys.schemas s ON s.schema_id = t.schema_id&#xA;JOIN DW_GrocerySales.sys.columns c ON c.object_id = t.object_id&#xA;WHERE c.name = N'TeritorijaSID'&#xA;  AND t.object_id &lt;&gt; OBJECT_ID(N'DW_GrocerySales.dbo.DimTeritorija','U');&#xA;IF (@add &lt;&gt; N'') EXEC DW_GrocerySales.sys.sp_executesql @add;&#xA;&#xA;-- 5) Brza verifikacija&#xA;SELECT DB_NAME() AS CurrentDb, OBJECT_ID(N'DW_GrocerySales.dbo.DimTeritorija','U') AS DimTeritorijaId;&#xA;SELECT TOP 1 * FROM DW_GrocerySales.dbo.DimTeritorija;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
