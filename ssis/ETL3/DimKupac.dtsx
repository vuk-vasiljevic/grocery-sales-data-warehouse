    <DTS:Executable
      DTS:refId="Package\Kreiranje tabela DimKupac"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{094CAC75-37F9-47E1-878C-8AC2288711CA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Kreiranje tabela DimKupac"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{053871B9-2090-4933-9DC9-7700EA52BCD7}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF DB_ID(N'DW_GrocerySales') IS NULL&#xA;    THROW 50001, 'Baza DW_GrocerySales ne postoji na ovom serveru.', 1;&#xA;&#xA;-- 1) Skini sve FK koji referenciraju DimKupac&#xA;DECLARE @drop NVARCHAR(MAX) = N'';&#xA;SELECT @drop = @drop +&#xA;    N'ALTER TABLE ' + QUOTENAME(SCHEMA_NAME(pt.schema_id)) + N'.' + QUOTENAME(pt.name) +&#xA;    N' DROP CONSTRAINT ' + QUOTENAME(fk.name) + N';' + CHAR(10)&#xA;FROM DW_GrocerySales.sys.foreign_keys fk&#xA;JOIN DW_GrocerySales.sys.tables pt ON pt.object_id = fk.parent_object_id&#xA;WHERE fk.referenced_object_id = OBJECT_ID(N'DW_GrocerySales.dbo.DimKupac','U');&#xA;IF (@drop &lt;&gt; N'') EXEC DW_GrocerySales.sys.sp_executesql @drop;&#xA;&#xA;-- 2) Drop/Create DimKupac&#xA;IF OBJECT_ID(N'DW_GrocerySales.dbo.DimKupac','U') IS NOT NULL&#xA;    DROP TABLE DW_GrocerySales.dbo.DimKupac;&#xA;&#xA;CREATE TABLE DW_GrocerySales.dbo.DimKupac&#xA;(&#xA;    KupacSID      INT IDENTITY(1,1) NOT NULL CONSTRAINT PK_DimKupac PRIMARY KEY,&#xA;    CustomerID    INT            NOT NULL,&#xA;    FirstName     NVARCHAR(50)   NOT NULL,&#xA;    LastName      NVARCHAR(50)   NOT NULL,&#xA;    TeritorijaSID INT            NOT NULL,&#xA;    CONSTRAINT FK_DimKupac_DimTeritorija&#xA;        FOREIGN KEY (TeritorijaSID)&#xA;        REFERENCES DW_GrocerySales.dbo.DimTeritorija (TeritorijaSID)&#xA;);&#xA;&#xA;-- 3) Seed: -1 / Unknown&#xA;SET IDENTITY_INSERT DW_GrocerySales.dbo.DimKupac ON;&#xA;INSERT INTO DW_GrocerySales.dbo.DimKupac (KupacSID, CustomerID, FirstName, LastName, TeritorijaSID)&#xA;VALUES (-1, 0, N'Unknown', N'Unknown', -1);&#xA;SET IDENTITY_INSERT DW_GrocerySales.dbo.DimKupac OFF;&#xA;&#xA;-- 4) Indeksi (preporuka): jedinstveno po CustomerID&#xA;IF NOT EXISTS (SELECT 1 FROM DW_GrocerySales.sys.indexes &#xA;               WHERE name = N'UX_DimKupac_CustomerID'&#xA;                 AND object_id = OBJECT_ID(N'DW_GrocerySales.dbo.DimKupac'))&#xA;    CREATE UNIQUE NONCLUSTERED INDEX UX_DimKupac_CustomerID&#xA;      ON DW_GrocerySales.dbo.DimKupac (CustomerID);&#xA;&#xA;-- 5) Vrati FK-ove za sve tabele koje imaju kolonu KupacSID (osim DimKupac)&#xA;DECLARE @add NVARCHAR(MAX) = N'';&#xA;SELECT @add = @add + N'&#xA;IF NOT EXISTS (SELECT 1 FROM DW_GrocerySales.sys.foreign_keys &#xA;               WHERE name = N''FK_' + t.name + '_DimKupac_KupacSID'')&#xA;BEGIN&#xA;  ALTER TABLE ' + QUOTENAME(s.name) + N'.' + QUOTENAME(t.name) + N'&#xA;    WITH NOCHECK ADD CONSTRAINT [FK_' + t.name + '_DimKupac_KupacSID]&#xA;    FOREIGN KEY ([KupacSID]) REFERENCES [DW_GrocerySales].[dbo].[DimKupac]([KupacSID]);&#xA;END&#xA;'&#xA;FROM DW_GrocerySales.sys.tables  t&#xA;JOIN DW_GrocerySales.sys.schemas s ON s.schema_id = t.schema_id&#xA;JOIN DW_GrocerySales.sys.columns c ON c.object_id = t.object_id&#xA;WHERE c.name = N'KupacSID'&#xA;  AND t.object_id &lt;&gt; OBJECT_ID(N'DW_GrocerySales.dbo.DimKupac','U');&#xA;IF (@add &lt;&gt; N'') EXEC DW_GrocerySales.sys.sp_executesql @add;&#xA;&#xA;-- (opciono) brza provera&#xA;SELECT TOP 1 * FROM DW_GrocerySales.dbo.DimKupac;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
